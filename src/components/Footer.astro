---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-placeholder.svg';
import { ADDRESS, EMAIL, PHONE_DISPLAY, telLink } from '../config';
---

<footer class="bg-navy text-bone">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-start md:justify-between">
    <div class="flex items-center gap-3">
      <Image src={logo} alt="Fathima Nursery Gardens" width={36} height={36} />
      <div>
        <p class="font-display text-lg tracking-[-0.02em]">Fathima Nursery Gardens</p>
        <p class="font-sans text-sm text-mist">Bringing back the green&hellip;</p>
      </div>
    </div>
    <div class="font-sans text-sm text-mist">
      <p>{ADDRESS}</p>
      <p class="mt-2">
        <a href={telLink()} class="hover:text-bone focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bone">
          {PHONE_DISPLAY}
        </a>
      </p>
      <p>
        <a href={`mailto:${EMAIL}`} class="hover:text-bone focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bone">
          {EMAIL}
        </a>
      </p>
    </div>
  </div>
</footer>
