---
import { telLink, whatsappLink } from '../config';

interface Props {
  message?: string;
  /** 'light' inverts the secondary button for use on navy. */
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  message = "Hi, I'd like to ask about availability and trade pricing.",
  tone = 'dark',
  size = 'md',
  class: className = '',
} = Astro.props;

const pad = size === 'sm' ? 'px-4 py-2.5 text-[13px]' : 'px-6 py-3.5 text-sm';

// On a green surface the green primary button disappears, so it becomes navy —
// the structure colour — and the outline button goes white.
const primary =
  tone === 'dark'
    ? 'bg-green text-white shadow-[0_10px_24px_-14px_rgba(0,171,79,0.9)] hover:bg-navy focus-visible:outline-green'
    : 'bg-navy text-bone shadow-[0_10px_24px_-14px_rgba(2,13,58,0.8)] hover:bg-ink focus-visible:outline-navy';

const secondary =
  tone === 'dark'
    ? 'border-navy/20 text-navy hover:border-navy hover:bg-navy hover:text-bone focus-visible:outline-navy'
    : 'border-white/50 text-white hover:border-white hover:bg-white hover:text-navy focus-visible:outline-white';
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
  <a
    href={whatsappLink(message)}
    target="_blank"
    rel="noopener noreferrer"
    class={`inline-flex items-center gap-2 rounded-lg font-sans font-medium transition duration-200 motion-safe:hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ${primary} ${pad}`}
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.81.83-3.03-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.17 1.73 2.65 4.2 3.71.59.26 1.04.41 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"
      ></path>
    </svg>
    Enquire on WhatsApp
  </a>
  <a
    href={telLink()}
    class={`inline-flex items-center gap-2 rounded-lg border font-sans font-medium transition duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ${secondary} ${pad}`}
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Call us
  </a>
</div>
