---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-placeholder.svg';
import { BUSINESS_NAME, telLink, whatsappLink } from '../config';

// Links point at homepage sections until the catalog, dispatch and contact
// pages exist. Swap to real routes as those pages land.
const links = [
  { label: 'Plants', href: '/#plants' },
  { label: 'Dispatch', href: '/#dispatch' },
  { label: 'About', href: '/#about' },
];
---

<header class="sticky top-0 z-50 border-b border-mist/80 bg-bone/85 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
    aria-label="Primary"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-navy"
    >
      <Image src={logo} alt={BUSINESS_NAME} width={32} height={32} class="h-8 w-8 shrink-0" />
      <span class="font-display text-[17px] leading-tight tracking-display text-navy sm:text-lg">
        Fathima Nursery
      </span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded font-sans text-sm text-ink/75 transition-colors hover:text-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-navy"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={telLink()}
        aria-label="Call the nursery"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-navy/15 text-navy transition-colors hover:border-navy hover:bg-navy hover:text-bone focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy sm:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a
        href={whatsappLink("Hi, I'd like to ask about availability and trade pricing.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-green px-3.5 py-2 font-sans text-[13px] font-medium text-white transition-colors hover:bg-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green sm:px-4"
      >
        <span class="hidden sm:inline">Enquire</span>
        <span class="sm:hidden">WhatsApp</span>
      </a>
    </div>
  </nav>
</header>
