---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-placeholder.svg';
import EnquiryButton from './EnquiryButton.astro';
---

<header class="border-b border-mist bg-bone">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Fathima Nursery Gardens" width={40} height={40} />
      <span class="font-display text-lg tracking-[-0.02em] text-navy">
        Fathima Nursery Gardens
      </span>
    </a>
    <EnquiryButton />
  </nav>
</header>
