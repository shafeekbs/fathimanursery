---
import type { CollectionEntry } from 'astro:content';
import PlantTag from './PlantTag.astro';

interface Props {
  plants: CollectionEntry<'plants'>[];
  class?: string;
}

const { plants, class: className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 ${className}`}>
  {plants.map((plant) => <PlantTag plant={plant} />)}
</div>
